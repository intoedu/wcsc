rules_version = '2';

/* CAPS_STORAGE_VERSION: 2026-08-14-a
 * =========================================================
 * 우리교회지원센터 — Firebase Storage 보안 규칙
 *
 * Firebase 콘솔 → Storage → [Rules] 탭에
 * 이 파일 내용을 그대로 붙여넣고 [게시] 를 누르세요.
 *
 * 여기에 올라가는 파일은 매물 권리 증빙(임대차계약서 · 등기부등본 등)
 * 하나뿐입니다. 계약서에는 이름 · 주소 · 금액 같은 민감한 정보가 들어 있어
 * 올린 본인과 승인된 센터 직원만 열 수 있게 막았습니다.
 * 게시판에는 절대 노출되지 않습니다.
 * ========================================================= */

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    /* Firestore 의 users 문서를 보고 승인된 직원인지 확인합니다. */
    function isStaff() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
             in ['owner', 'admin', 'staff'];
    }

    /* 매물 권리 증빙 — listing-proofs/{올린 사람 uid}/{파일명} */
    match /listing-proofs/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());

      // 본인만 올릴 수 있고, 이미지 또는 PDF 10MB 까지입니다.
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');

      // 확인이 끝나면 지웁니다 (본인 또는 직원).
      allow delete: if signedIn() && (request.auth.uid == userId || isStaff());
    }

    /* 그 외 경로는 모두 차단 */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
